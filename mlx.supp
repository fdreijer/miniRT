{
   mlx_x11_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   obj:*/libX11.so*
}

{
   mlx_x11_calloc_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:calloc
   obj:*/libX11.so*
}

{
   mlx_xext_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   obj:*/libXext.so*
}

{
   mlx_xext_calloc_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:calloc
   obj:*/libXext.so*
}

{
   mlx_libxcb_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   obj:*/libxcb.so*
}

{
   mlx_libxrender_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   obj:*/libXrender.so*
}